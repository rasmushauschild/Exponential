{
  "name": "exponential",
  "productName": "Exponential",
  "version": "0.1.0",
  "description": "Simple team planning: the big plan and the week, side by side.",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "dist": "vite build && electron-builder",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:win": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.airy.exponential",
    "productName": "Exponential",
    "files": [
      "dist/**",
      "electron/**",
      "!electron/google.client.example.json",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "extendInfo": {
        "CFBundleIconName": "exponential"
      },
      "extraResources": [
        {
          "from": "build/Assets.car",
          "to": "Assets.car"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.6.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
